QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=opslens_sops
# Optional persistent embedded mode for single-process development:
# QDRANT_URL=embedded
# QDRANT_PATH=./qdrant_data

# Optional assistant LLM. Leave unset for deterministic record-grounded answers.
# OPSLENS_LLM_PROVIDER=none|groq|gemini|openai|anthropic|ollama|openai_compatible|transformers
# OPSLENS_LLM_MODEL=openai/gpt-oss-20b
# OPSLENS_LLM_TIMEOUT=8
# GROQ_API_KEY=
# GROQ_API_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# EDGE_LLM_URL=http://localhost:11434
# EDGE_LLM_MODEL=qwen2.5:0.5b
# OPSLENS_OFFLINE=false
# OPSLENS_ASSISTANT_HISTORY_LIMIT=8
# OPSLENS_ASSISTANT_CACHE_TTL=120
