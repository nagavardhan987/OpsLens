# =============================================================================
# OpsLens backend configuration (copy to edge_intelligence\.env and edit)
# .env is git-ignored. Never commit API keys, passwords or certificates.
# Values already set in the process environment override this file.
# =============================================================================

# ---- Server -----------------------------------------------------------------
OPSLENS_HOST=127.0.0.1
OPSLENS_PORT=8001
# Optional: keep the SQLite database outside the program folder.
# OPSLENS_DB_PATH=C:\OpsLensData\opslens.db

# ---- AI provider (optional) -------------------------------------------------
# OpsLens starts and works WITHOUT any LLM: alarms, evidence, SOP steps and the
# operator brief are deterministic. An LLM only rephrases Ask OpsLens answers,
# and every answer is validated against the recorded data before it is shown.
#
# Local Ollama (recommended, offline):
OPSLENS_LLM_PROVIDER=ollama
EDGE_LLM_URL=http://localhost:11434
EDGE_LLM_MODEL=qwen2.5:3b
# CPU inference of a 3B model (with a cold model load) can take 10-60 s.
OPSLENS_OLLAMA_TIMEOUT=60
OPSLENS_OLLAMA_CONNECT_TIMEOUT=2
# Keep the model loaded between questions.
OPSLENS_OLLAMA_KEEP_ALIVE=30m
OPSLENS_OLLAMA_NUM_PREDICT=320
#
# Groq cloud (optional fallback; requires internet):
# OPSLENS_LLM_PROVIDER=groq
# GROQ_API_KEY=
# OPSLENS_LLM_MODEL=openai/gpt-oss-20b
# OPSLENS_LLM_TIMEOUT=8
#
# Deterministic only (no LLM at all):
# OPSLENS_LLM_PROVIDER=none
#
# Let the LLM also draft the pipeline guidance text (default false: verbatim SOP steps):
# OPSLENS_GUIDANCE_USE_LLM=false
# OPSLENS_LLM_MAX_CONCURRENCY=3
# OPSLENS_LLM_QUEUE_TIMEOUT=0.25
# OPSLENS_ASSISTANT_SINGLEFLIGHT_TIMEOUT=75
# OPSLENS_ASSISTANT_CONTEXT_WINDOW_MINUTES=30

# ---- SOP retrieval ----------------------------------------------------------
# Qdrant is OPTIONAL. Without it (or without sentence-transformers) OpsLens uses
# BM25 keyword retrieval and says so in /api/health and /api/diagnostics.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=opslens_sops
# Single-process embedded Qdrant instead of a service:
# QDRANT_URL=embedded
# QDRANT_PATH=./qdrant_data

# ---- Alarm reference (derived from SOP-MAN-000, page-cited) -----------------
# OPSLENS_ALARM_REFERENCE=./config/alarm_reference.json

# ---- Shift handover ---------------------------------------------------------
# 24-hour HH:MM in this PC's local time. Leave blank to show "not configured".
OPSLENS_SHIFT_NAME=Night
OPSLENS_SHIFT_START=18:00
OPSLENS_SHIFT_END=06:00

# ---- Scenario Lab -----------------------------------------------------------
# A run still marked "running" after this many seconds is treated as stale.
OPSLENS_SCENARIO_STALE_SECONDS=600

# ---- Read-only PLC (OPC UA) -------------------------------------------------
# Disabled until a real endpoint and an explicit NodeId mapping are supplied.
# See PLC_OPCUA_SETUP.md. OpsLens never writes to the PLC.
PLC_OPCUA_ENABLED=false
PLC_OPCUA_ENDPOINT=
PLC_OPCUA_SECURITY_POLICY=
PLC_OPCUA_SECURITY_MODE=None
PLC_OPCUA_USERNAME=
PLC_OPCUA_PASSWORD=
PLC_OPCUA_CLIENT_CERTIFICATE=
PLC_OPCUA_CLIENT_PRIVATE_KEY=
PLC_OPCUA_PRIVATE_KEY_PASSWORD=
PLC_OPCUA_SERVER_CERTIFICATE=
PLC_OPCUA_TAG_MAPPING=./plc_tag_mapping.json
PLC_OPCUA_POLL_INTERVAL=1
PLC_OPCUA_RECONNECT_MIN_SECONDS=1
PLC_OPCUA_RECONNECT_MAX_SECONDS=30
PLC_OPCUA_STALE_AFTER_SECONDS=10
