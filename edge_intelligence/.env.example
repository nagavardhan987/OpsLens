QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=opslens_sops
# Optional persistent embedded mode for single-process development:
# QDRANT_URL=embedded
# QDRANT_PATH=./qdrant_data

# Optional assistant LLM. Leave unset for deterministic record-grounded answers.
# OPSLENS_LLM_PROVIDER=none|groq|gemini|openai|anthropic|ollama|openai_compatible|transformers
# OPSLENS_LLM_MODEL=openai/gpt-oss-20b
# Provider request timeout in seconds (default 4; timeout returns the deterministic answer).
# OPSLENS_LLM_TIMEOUT=4
# Maximum provider calls across simultaneous incidents (default 3).
# OPSLENS_LLM_MAX_CONCURRENCY=3
# Maximum wait for a provider slot in seconds (default 0.25).
# OPSLENS_LLM_QUEUE_TIMEOUT=0.25
# One Groq 429 retry is allowed only when its retry delay fits this budget (default 0.5s).
# OPSLENS_GROQ_MAX_RETRY_WAIT=0.5
# GROQ_API_KEY=
# GROQ_API_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# EDGE_LLM_URL=http://localhost:11434
# EDGE_LLM_MODEL=qwen2.5:0.5b
# OPSLENS_OFFLINE=false
# OPSLENS_ASSISTANT_HISTORY_LIMIT=8
# OPSLENS_ASSISTANT_CACHE_TTL=120
# Maximum wait for an identical in-flight incident analysis before returning a retryable 503 (default 30s).
# OPSLENS_ASSISTANT_SINGLEFLIGHT_TIMEOUT=30
# Incident context window in minutes (default 30, bounded to 1–1440).
# OPSLENS_ASSISTANT_CONTEXT_WINDOW_MINUTES=30

# Optional read-only PLC connection. Disabled until endpoint and explicit NodeId mapping are supplied.
PLC_OPCUA_ENABLED=false
PLC_OPCUA_ENDPOINT=
PLC_OPCUA_SECURITY_POLICY=
PLC_OPCUA_SECURITY_MODE=None
PLC_OPCUA_USERNAME=
PLC_OPCUA_PASSWORD=
PLC_OPCUA_CLIENT_CERTIFICATE=
PLC_OPCUA_CLIENT_PRIVATE_KEY=
PLC_OPCUA_PRIVATE_KEY_PASSWORD=
PLC_OPCUA_SERVER_CERTIFICATE=
PLC_OPCUA_TAG_MAPPING=./plc_tag_mapping.json
PLC_OPCUA_POLL_INTERVAL=1
PLC_OPCUA_RECONNECT_MIN_SECONDS=1
PLC_OPCUA_RECONNECT_MAX_SECONDS=30
PLC_OPCUA_STALE_AFTER_SECONDS=10
